[node name="Scroll" type="ScrollContainer" parent="MarginContainer/Content"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Manuscript" type="Label" parent="MarginContainer/Content/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
autowrap_mode = 3

[node name="StartButton" type="Button" parent="MarginContainer/Content"]
layout_mode = 2
