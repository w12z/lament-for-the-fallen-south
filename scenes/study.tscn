[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/study.gd" id="1_study"]
[ext_resource type="PackedScene" path="res://scenes/ui/paper_background.tscn" id="2_paper"]

[node name="Study" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_study")

[node name="PaperBackground" parent="." instance=ExtResource("2_paper")]

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 64
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 64
theme_override_constants/margin_bottom = 40

[node name="Content" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "哀江南 · 晚年书房"
horizontal_alignment = 1

[node name="Introduction" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
theme_type_variation = &"InkNote"
text = "故国已远，纸上尚空。提笔回望，又该从何处写起？"
horizontal_alignment = 1
autowrap_mode = 3

[node name="RoundLabel" type="Label" parent="MarginContainer/Content"]
layout_mode = 2
